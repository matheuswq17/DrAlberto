# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Usada apenas pelo worker e por rotas server-side (nunca exposta ao browser)
SUPABASE_SERVICE_ROLE_KEY=

# ===== Google (Service Account com acesso de LEITURA ao Calendar e ao Sheets) =====
# JSON da service account codificado em base64 (uma linha):
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("sa.json"))
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Calendário único do Dr. Alberto (mesmo que o bot usa)
GOOGLE_CALENDAR_ID=
# Planilha de leads do bot (mesma do n8n) e nome da aba
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_LEADS_TAB=Leads

# ===== Evolution API (mesma instância do bot) =====
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ===== WhatsApp — segurança =====
# Em safe mode (default), TODO envio é redirecionado para o número de teste
# autorizado. Só desligar em produção com ok explícito do Matheus.
WHATSAPP_SAFE_MODE=true
WHATSAPP_TEST_NUMBER=11939011304

# ===== Relatório periódico (func. 7) =====
# Número do Dr. Alberto para receber o relatório (com DDD, só dígitos)
REPORT_PHONE=

# ===== Geral =====
TZ=America/Sao_Paulo
